<?xml version="1.0" encoding="UTF-8"?>
<!-- UR3 SRDF + the Robotiq 2F-85 attached at tool0 through the UR adapter. Same as
     ur_moveit_config's ur.srdf.xacro, plus collision exclusions for the gripper - the
     gripper is rigidly attached and never touches the arm, and without these pairs the
     start state is reported as in collision (every plan then fails). Table collisions
     stay enabled. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_adapter_ref" link2="robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_link" reason="Never" />
